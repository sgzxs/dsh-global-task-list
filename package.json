{
  "name": "dsh-global-task-list",
  "version": "0.2.6",
  "description": "Global task library with a persistent interactive panel: task CRUD tools, linked-subagent terminal-status sync, and a generative-UI surface renderer for the DeepSeek Harness",
  "homepage": "https://github.com/sgzxs/dsh-global-task-list#readme",
  "bugs": {
    "url": "https://github.com/sgzxs/dsh-global-task-list/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgzxs/dsh-global-task-list.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "skills/task-ui/SKILL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:host": "tsdown -c tsdown.host.config.mjs",
    "build:client": "tsdown",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:host && npm run build:client",
    "test": "npm run typecheck && node test/client-smoke.mjs && node test/host-smoke.mjs && node test/render-check.mjs && node test/class-check.mjs && node test/bundle-css-check.mjs",
    "prepare": "npm run build:host && npm run build:client",
    "sync": "node sync-profile.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^24.19.0",
    "@types/react": "^18.2.0",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.13.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": false
    }
  }
}
